# ==============================================================================
# EXAM HALL MONITORING ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development or set these variables in your
# hosting environment (e.g., Render, Railway, Heroku, Docker, or AWS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED] HTTP Port for the Express application server.
# Default: 3000
PORT=3000

# [REQUIRED] Environment runtime mode ('development' or 'production').
# Development enables Vite SPA HMR middleware; Production serves static dist builds.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR AUTHENTICATION (SECURITY CRITICAL)
# ------------------------------------------------------------------------------
# [REQUIRED] Administrator username for logging into the Admin Control Panel.
# There are NO default or hardcoded credentials in the application.
ADMIN_USERNAME=admin

# [REQUIRED] Administrator password for logging into the Admin Control Panel.
# Strong password required for production deployment.
ADMIN_PASSWORD=change_this_to_a_secure_password_123!

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MONGODB PERSISTENCE)
# ------------------------------------------------------------------------------
# [REQUIRED FOR PERSISTENCE] MongoDB connection URI string.
# Local MongoDB example: mongodb://localhost:27017
# MongoDB Atlas production example: mongodb+x509://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# If omitted or unconfigured, system logs a warning and falls back to local data/exam_monitoring.json storage.
MONGODB_URI=mongodb://localhost:27017

# [OPTIONAL] MongoDB Database Name.
# Default: exam_monitoring
MONGODB_DB_NAME=exam_monitoring

# ------------------------------------------------------------------------------
# 4. COMPUTER VISION ENGINE & MICROSERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] URL of external Python FastAPI YOLOv8 CV worker microservice.
# If unconfigured, server uses embedded JavaScript CV state engine.
# Example: http://127.0.0.1:8000
CV_WORKER_URL=http://127.0.0.1:8000

# [OPTIONAL] Automatically detected! During `npm install`, yolov8n.pt is auto-downloaded
# to cv_service/models/yolov8n.pt and ./yolov8n.pt. No manual path configuration needed.
CV_MODEL_PATH=cv_service/models/yolov8n.pt

# [OPTIONAL] Automatically launch Python CV microservice process with server.
# Set to 'false' to disable, or 'true' to force launch with system Python. Default: auto-detected.
AUTO_START_CV=true

# [OPTIONAL] Minimum detection confidence score (0.0 to 1.0).
# Detections below this confidence threshold are ignored. Default: 0.30
CV_CONF_THRESHOLD=0.30

# [OPTIONAL] Milliseconds interval between client vision processing frames.
# Lower value = higher FPS but higher CPU/GPU load. Default: 250
DETECTION_INTERVAL_MS=250

# ------------------------------------------------------------------------------
# 5. MEDIA & STREAM PROCESSING
# ------------------------------------------------------------------------------
# [OPTIONAL] Custom path to FFmpeg binary executable for RTSP / IP stream frame extraction.
# Default: uses system `ffmpeg` in PATH
FFMPEG_PATH=ffmpeg

# [OPTIONAL] Maximum video upload file size limit in bytes.
# Default: 1073741824 (1GB)
MAX_UPLOAD_SIZE_BYTES=1073741824
